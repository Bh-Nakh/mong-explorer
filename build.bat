@echo off
chcp 65001 >nul
setlocal
rem Mong Explorer build - uses the C# compiler built into Windows (.NET Framework 4), no install needed
rem App name (Korean) lives in app.name so this file stays ASCII-only.
rem Version comes from the VERSION file (src\Version.cs is generated).
rem   build.bat          -> bin\<name>.exe + release\<name>.exe (committed, used by auto update)
rem                         + release\NewExplorer.exe (legacy file name: PCs still running the old
rem                           NewExplorer.exe auto-update from this path; remove once all PCs have updated)
rem   build.bat test     -> test\<name>.exe only (for testing while the app is running)
cd /d "%~dp0"
set /p APPNAME=<app.name
set OUT=bin
if not "%~1"=="" set OUT=%~1
set /p VER=<VERSION
for /f "tokens=* delims= " %%a in ("%VER%") do set VER=%%a
> src\Version.cs echo // generated by build.bat from VERSION - do not edit
>> src\Version.cs echo namespace NewExplorer { static class AppVersion { public const string Value = "%VER%"; } }
set CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe
if not exist "%CSC%" set CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe
if not exist "%OUT%" mkdir "%OUT%"
rem Locked (running) exe files are renamed to .old instead of asking the user to close the app (common tool tools\free_locked.ps1)
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0tools\free_locked.ps1" "%OUT%" "%APPNAME%.exe"
if /i "%OUT%"=="bin" powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0tools\free_locked.ps1" release "%APPNAME%.exe" NewExplorer.exe
"%CSC%" /nologo /codepage:65001 /target:winexe /platform:anycpu /optimize+ /out:"%OUT%\%APPNAME%.exe" /win32icon:assets\app.ico /win32manifest:assets\app.manifest /r:System.dll /r:System.Drawing.dll /r:System.Windows.Forms.dll /r:System.Web.Extensions.dll /r:Microsoft.VisualBasic.dll src\*.cs
if errorlevel 1 (
  echo BUILD FAILED
  exit /b 1
)
if /i "%OUT%"=="bin" (
  if not exist release mkdir release
  copy /y "bin\%APPNAME%.exe" "release\%APPNAME%.exe" >nul
  if errorlevel 1 ( echo BUILD FAILED: cannot write release\%APPNAME%.exe & exit /b 1 )
  copy /y "bin\%APPNAME%.exe" release\NewExplorer.exe >nul 2>&1
  if errorlevel 1 echo WARNING: release\NewExplorer.exe was not updated - close the old NewExplorer.exe and build again
  echo BUILD OK: v%VER% bin\%APPNAME%.exe, release\%APPNAME%.exe
) else (
  echo BUILD OK: v%VER% %OUT%\%APPNAME%.exe
)
